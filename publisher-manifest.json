l .row{grid-template-columns:1fr;gap:20px}\n  .usage-grid{grid-template-columns:1fr;gap:32px}\n  nav.top .links{display:none}\n  .hero-text h1{font-size:32px}\n  .qa.a{margin-left:20px}}\n</style><nav class=\"top\">\n  <div class=\"wrap\">\n    <div class=\"brand\">極速亞洲(SpaceZ)</div>\n    <div class=\"links\">\n      <a href=\"#plans\">订阅方案</a>\n      <a href=\"#usage\">使用说明</a>\n      <a href=\"#faq\">常见问题</a>\n      <a href=\"#legal\">服务说明</a>\n    </div>\n  </div>\n</nav>\n\n<main>\n  <section class=\"hero\" id=\"top\">\n    <div class=\"wrap\">\n      <div class=\"hero-grid\">\n        <div class=\"hero-text\">\n          <h1>\n            極速亞洲(SpaceZ)\n            <span class=\"en\">SPACEZ · NEUTRAL RELAY SERVICE</span>\n          </h1>\n          <p class=\"lede\">\n            本服务以中性方式提供网络中继与路由调度能力，面向个人与团队按月订阅。以下内容为订阅方案、接入步骤与服务说明，所有描述以本页为准，未列明事项不另行承诺。\n          </p>\n          <div class=\"meta\">\n            <span><b>订阅模式</b>按月 / 按年</span>\n            <span><b>设备支持</b>3 至 20 台</span>\n            <span><b>流量结算</b>月度重置</span>\n            <span><b>支持渠道</b>工单优先</span>\n          </div>\n        </div>\n        <aside class=\"hero-panel\">\n          <h2>本页信息卡</h2>\n          <ul>\n            <li><span class=\"k\">服务性质</span><span class=\"v\">中性网络中继</span></li>\n            <li><span class=\"k\">订阅单位</span><span class=\"v\">月 / 年</span></li>\n            <li><span class=\"k\">接入方式</span><span class=\"v\">客户端配置</span></li>\n            <li><span class=\"k\">支持终端</span><span class=\"v\">多设备并发</span></li>\n            <li><span class=\"k\">本页版本</span><span class=\"v\">静态说明页</span></li>\n          </ul>\n          <p class=\"note\">本页所列方案与说明为静态展示内容，不构成实时交易承诺。具体开通与使用以实际订阅页面为准。</p>\n        </aside>\n      </div>\n    </div>\n  </section>\n\n  <section id=\"about\">\n    <div class=\"wrap intro\">\n      <h2 class=\"sec\">关于本服务</h2>\n      <h3 class=\"sec\">说明而非承诺</h3>\n      <p>\n        極速亞洲(SpaceZ) 以静态说明方式呈现订阅方案与使用流程。服务内容以流量额度、设备数量、支持范围三项可量化指标为核心，不附加未列明的性能保证。\n      </p>\n      <p>\n        所有方案按月或按年结算，流量于订阅周期内重置；设备并发数以方案标注上限为准，超出部分不予连接。若需更高带宽或定制路由，建议选择对应方案或通过工单确认。\n      </p>\n      <p>\n        本页未提供客户端下载链接，相关安装包以实际订阅后获取的地址为准；未列明的事项不构成服务组成部分。\n      </p>\n    </div>\n  </section>\n\n  <section id=\"plans\">\n    <div class=\"wrap\">\n      <div class=\"plans-head\">\n        <div>\n          <h2 class=\"sec\">订阅方案</h2>\n          <h3 class=\"sec\">两栏对照，按需选择</h3>\n        </div>\n        <p class=\"desc\">以下为当前展示的三档方案，价格与权益以本页为准；年付价格为对应月费乘以十，不另行叠加优惠。</p>\n      </div>\n\n      <div class=\"plans-grid\">\n        <article class=\"plan\">\n          <div class=\"tag\">PLAN A</div>\n          <div class=\"name\">基础版</div>\n          <div class=\"price\">¥15 / 月</div>\n          <div class=\"annual\">按年付仅需 ¥150 / 年</div>\n          <ul>\n            <li>每月 100GB 极速流量</li>\n            <li>支持 3 台设备同时在线</li>\n            <li>解锁基础流媒体</li>\n            <li>普通线路节点池</li>\n          </ul>\n        </article>\n\n        <article class=\"plan featured\">\n          <span class=\"badge\">推荐</span>\n          <div class=\"tag\">PLAN B</div>\n          <div class=\"name\">旗舰版</div>\n          <div class=\"price\">¥35 / 月</div>\n          <div class=\"annual\">按年付仅需 ¥350 / 年</div>\n          <ul>\n            <li>每月 300GB 极速流量</li>\n            <li>支持 5 台设备同时在线</li>\n            <li>全节点原生流媒体解锁</li>\n            <li>IPLC 专线游戏加速优化</li>\n            <li>7×24 优先工单支持</li>\n          </ul>\n        </article>\n\n        <article class=\"plan full\">\n          <div class=\"row\">\n            <div>\n              <h4>PLAN C</h4>\n              <div class=\"name\">团队版</div>\n              <div class=\"price\">¥85 / 月</div>\n              <div class=\"annual\">按年付仅需 ¥850 / 年</div>\n            </div>\n            <div>\n              <h4>面向场景</h4>\n              <p>\n                适用于多成员协作场景，支持更高并发与专属客户经理对接，适合需要稳定调度与定制路由的团队。\n              </p>\n            </div>\n            <div>\n              <h4>权益明细</h4>\n              <ul>\n                <li>每月 1000GB 极速流量</li>\n                <li>支持 20 台设备同时在线</li>\n                <li>VIP 专属高带宽节点</li>\n                <li>支持企业定制路由</li>\n                <li>专属客户经理服务</li>\n              </ul>\n            </div>\n          </div>\n        </article>\n      </div>\n    </div>\n  </section>\n\n  <section id=\"usage\">\n    <div class=\"wrap\">\n      <h2 class=\"sec\">使用说明</h2>\n      <h3 class=\"sec\">从订阅到接入</h3>\n      <div class=\"usage-grid\">\n        <div class=\"step\">\n          <div class=\"num\">STEP 01</div>\n          <h3>选择订阅方案</h3>\n          <p>根据设备数量与流量需求选择对应方案；年付价格为月费乘以十，无额外折扣叠加。</p>\n        </div>\n        <div class=\"step\">\n          <div class=\"num\">STEP 02</div>\n          <h3>完成订阅并获取凭证</h3>\n          <p>订阅完成后，通过对应渠道获取接入凭证与节点信息；凭证与设备数量绑定，不可转让。</p>\n        </div>\n        <div class=\"step\">\n          <div class=\"num\">STEP 03</div>\n          <h3>配置客户端</h3>\n          <p>按实际订阅后获取的客户端与地址进行安装和导入；本页不提供固定下载链接，避免地址过期。</p>\n        </div>\n        <div class=\"step\">\n          <div class=\"num\">STEP 04</div>\n          <h3>选择节点与路由</h3>\n          <p>在客户端内选择对应节点池；旗舰版及以上支持专线与定制路由，具体可用范围以订阅方案为准。</p>\n        </div>\n        <div class=\"step\">\n          <div class=\"num\">STEP 05</div>\n          <h3>设备并发管理</h3>\n          <p>同时在线设备数不得超过方案上限，超出将被拒绝连接；建议在客户端内管理已激活设备。</p>\n        </div>\n        <div class=\"step\">\n          <div class=\"num\">STEP 06</div>\n          <h3>流量与周期</h3>\n          <p>流量按月计算并于订阅周期内重置；未使用部分不结转，超额后需升级方案或等待周期重置。</p>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <section id=\"faq\">\n    <div class=\"wrap\">\n      <h2 class=\"sec\">常见问题</h2>\n      <h3 class=\"sec\">以问答方式说明</h3>\n      <div class=\"faq-list\">\n        <div class=\"qa q\">\n          <div class=\"avatar\">Q</div>\n          <div class=\"bubble\">\n            <div class=\"who\">用户提问</div>\n            <p>基础版和旗舰版的主要区别是什么？</p>\n          </div>\n        </div>\n        <div class=\"qa a\">\n          <div class=\"avatar\">A</div>\n          <div class=\"bubble\">\n            <div class=\"who\">服务说明</div>\n            <p>两者在流量额度、设备数量、节点池类型和支持优先级上不同。基础版为 100GB / 3 设备 / 普通节点池；旗舰版为 300GB / 5 设备 / 全节点原生解锁，并包含 IPLC 专线优化与优先工单支持。</p>\n          </div>\n        </div>\n\n        <div class=\"qa q\">\n          <div class=\"avatar\">Q</div>\n          <div class=\"bubble\">\n            <div class=\"who\">用户提问</div>\n            <p>年付价格如何计算？</p>\n          </div>\n        </div>\n        <div class=\"qa a\">\n          <div class=\"avatar\">A</div>\n          <div class=\"bubble\">\n            <div class=\"who\">服务说明</div>\n            <p>年付价格为对应月费乘以十。例如基础版月费 ¥15，年付为 ¥150；旗舰版月费 ¥35，年付为 ¥350。不另行叠加其他优惠。</p>\n          </div>\n        </div>\n\n        <div class=\"qa q\">\n          <div class=\"avatar\">Q</div>\n          <div class=\"bubble\">\n            <div class=\"who\">用户提问</div>\n            <p>本页为什么不提供客户端下载链接？</p>\n          </div>\n        </div>\n        <div class=\"qa a\">\n          <div class=\"avatar\">A</div>\n          <div class=\"bubble\">\n            <div class=\"who\">服务说明</div>\n            <p>为避免地址失效或版本不一致，客户端地址以实际订阅后获取为准。本页作为静态说明，不固定写入下载链接。</p>\n          </div>\n        </div>\n\n        <div class=\"qa q\">\n          <div class=\"avatar\">Q</div>\n          <div class=\"bubble\">\n            <div class=\"who\">用户提问</div>\n            <p>设备超出方案上限会怎样？</p>\n          </div>\n        </div>\n        <div class=\"qa a\">\n          <div class=\"avatar\">A</div>\n          <div class=\"bubble\">\n            <div class=\"who\">服务说明</div>\n            <p>超出上限的新设备将被拒绝连接，已有连接不受立即影响。建议在客户端内管理已激活设备，或升级至支持更高并发的方案。</p>\n          </div>\n        </div>\n\n        <div class=\"qa q\">\n          <div class=\"avatar\">Q</div>\n          <div class=\"bubble\">\n            <div class=\"who\">用户提问</div>\n            <p>流量未用完是否可以结转？</p>\n          </div>\n        </div>\n        <div class=\"qa a\">\n          <div class=\"avatar\">A</div>\n          <div class=\"bubble\">\n            <div class=\"who\">服务说明</div>\n            <p>不支持结转。流量按月计算并于订阅周期内重置，未使用部分在周期结束后清零。</p>\n          </div>\n        </div>\n\n        <div class=\"qa q\">\n          <div class=\"avatar\">Q</div>\n          <div class=\"bubble\">\n            <div class=\"who\">用户提问</div>\n            <p>团队版的企业定制路由如何理解？</p>\n          </div>\n        </div>\n        <div class=\"qa a\">\n          <div class=\"avatar\">A</div>\n          <div class=\"bubble\">\n            <div class=\"who\">服务说明</div>\n            <p>团队版支持 VIP 专属高带宽节点与企业定制路由，具体可用范围与配置方式以订阅后通过专属客户经理确认的内容为准。</p>\n          </div>\n        </div>\n      </div>\n    </div>\n  </section>\n</main>\n\n<footer id=\"legal\">\n  <div class=\"wrap\">\n    <div class=\"legal\">\n      極速亞洲(SpaceZ) 本页为静态说明文档，所列方案、价格与权益以页面内容为准；未列明的事项不构成服务承诺。客户端地址与实际开通流程以订阅后获取的信息为准。\n    </div>\n    <div>\n      <div>極速亞洲(SpaceZ)</div>\n      <div>静态说明页 · 按月订阅</div>\n    </div>\n  </div>\n</footer>",
